 /* {{{ Shm buffer handling */
 
@@ -239,6 +242,84 @@
 
 /* }}} */
 
+GdkColorState *
+_gdk_wayland_shm_texture_color_state (GdkTexture *texture)
+{
+  return GDK_IS_MEMORY_TEXTURE (texture) ? gdk_color_state_get_rec2100_pq ()
+                                        : gdk_texture_get_color_state (texture);
+}
+
+/* HDR memory textures need high precision and their actual color state. */
+gboolean
+_gdk_wayland_shm_texture_use_hdr (GdkWaylandDisplay *display,
+                                 GdkTexture        *texture)
+{
+  GdkCicpParams *params;
+  guint transfer;
+
+  if (!display->shm_abgr16f ||
+      g_strcmp0 (g_getenv ("GDK_MEDIA_ONLY_HDR"), "1") != 0)
+    return FALSE;
+
+  params = gdk_color_state_create_cicp_params (gdk_texture_get_color_state (texture));
+  if (!params)
+    return FALSE;
+  transfer = gdk_cicp_params_get_transfer_function (params);
+  g_object_unref (params);
+  return transfer == 16 || transfer == 18;
+}
+
+typedef struct {
+  gpointer pixels;
+  size_t size;
+  struct wl_shm_pool *pool;
+} HdrShmData;
+
+static void
+hdr_shm_release (void *data, struct wl_buffer *buffer)
+{
+  HdrShmData *hdr = data;
+  wl_buffer_destroy (buffer);
+  wl_shm_pool_destroy (hdr->pool);
+  munmap (hdr->pixels, hdr->size);
+  g_free (hdr);
+}
+
+static const struct wl_buffer_listener hdr_shm_listener = { hdr_shm_release };
+
+static struct wl_buffer *
+hdr_shm_buffer (GdkWaylandDisplay *display, GdkTexture *texture)
+{
+  int width = gdk_texture_get_width (texture);
+  int height = gdk_texture_get_height (texture);
+  int stride;
+  HdrShmData *data;
+  GdkTextureDownloader *downloader;
+  struct wl_buffer *buffer;
+
+  if (width > G_MAXINT / 8 || height > G_MAXINT / (width * 8))
+    return NULL;
+  stride = width * 8;
+  data = g_new0 (HdrShmData, 1);
+  data->pool = create_shm_pool (display->shm, height * stride,
+                                &data->size, &data->pixels);
+  if (!data->pool)
+    {
+      g_free (data);
+      return NULL;
+    }
+
+  downloader = gdk_texture_downloader_new (texture);
+  gdk_texture_downloader_set_format (downloader, GDK_MEMORY_R16G16B16A16_FLOAT_PREMULTIPLIED);
+  gdk_texture_downloader_set_color_state (downloader, _gdk_wayland_shm_texture_color_state (texture));
+  gdk_texture_downloader_download_into (downloader, data->pixels, stride);
+  gdk_texture_downloader_free (downloader);
+  buffer = wl_shm_pool_create_buffer (data->pool, 0, width, height, stride,
+                                       WL_SHM_FORMAT_ABGR16161616F);
+  wl_buffer_add_listener (buffer, &hdr_shm_listener, data);
+  return buffer;
+}
+
 struct wl_buffer *
 _gdk_wayland_shm_texture_get_wl_buffer (GdkWaylandDisplay *display,
                                         GdkTexture        *texture)
@@ -248,11 +329,15 @@
   GdkTextureDownloader *downloader;
   struct wl_buffer *buffer;
 
+  if (_gdk_wayland_shm_texture_use_hdr (display, texture))
