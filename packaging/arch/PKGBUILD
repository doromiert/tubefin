pkgname=tubefin
pkgver=1.7.4
pkgrel=1
pkgdesc='Native GTK YouTube and Jellyfin client'
arch=('any')
url='https://github.com/doromiert/tubefin'
license=('GPL-3.0-or-later')
depends=(
  'deno'
  'ffmpeg'
  'gst-libav'
  'gst-plugins-bad'
  'gst-plugins-base'
  'gst-plugins-good'
  'gst-plugins-ugly'
  'gtk4'
  'libadwaita'
  'libsecret'
  'mpv'
  'python'
  'python-gobject'
  'python-mpv'
  'python-pynacl'
  'webkitgtk-6.0'
  'python-websocket-client'
  'yt-dlp'
)
makedepends=('git')
source=("git+$url.git#tag=v$pkgver")
sha256sums=('SKIP')

package() {
  cd "$pkgname"
  install -d "$pkgdir/usr/lib/tubefin"
  cp -a src/tubefin "$pkgdir/usr/lib/tubefin/"
  find "$pkgdir/usr/lib/tubefin" -type d -name __pycache__ -prune -exec rm -rf {} +
  install -Dm755 packaging/arch/tubefin "$pkgdir/usr/bin/tubefin"
  install -Dm644 data/com.neg-zero.Tubefin.desktop \
    "$pkgdir/usr/share/applications/com.neg-zero.Tubefin.desktop"
  install -Dm644 data/com.neg-zero.Tubefin.metainfo.xml \
    "$pkgdir/usr/share/metainfo/com.neg-zero.Tubefin.metainfo.xml"
  install -Dm644 data/com.neg-zero.Tubefin.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/com.neg-zero.Tubefin.svg"
}
